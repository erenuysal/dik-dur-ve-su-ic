{
  "expo": {
    "name": "Dik dur ve su iç",
    "slug": "dik-dur-ve-su-ic",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "dikdurvesuic",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "platforms": [
      "ios",
      "android"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.seperra.dikdurvesuic",
      "infoPlist": {
        "CFBundleDisplayName": "Dik dur ve su iç",
        "NSUserNotificationsUsageDescription": "Dik durman ve su içmen için gün içinde nazik hatırlatmalar göndeririz.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.seperra.dikdurvesuic",
      "adaptiveIcon": {
        "backgroundColor": "#1F6B5A",
        "foregroundImage": "./assets/adaptive-icon.png"
      },
      "permissions": [
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.SCHEDULE_EXACT_ALARM",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.VIBRATE"
      ]
    },
    "plugins": [
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#1F6B5A",
          "defaultChannel": "hatirlatmalar"
        }
      ],
      "expo-status-bar"
    ],
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#F4EFE6"
    },
    "extra": {
      "eas": {
        "projectId": "5b0818ca-fd0e-47d1-aae3-03720068aaf2"
      }
    },
    "owner": "seperrasoftware"
  }
}
